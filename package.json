{
  "name": "ecs-ai-workbench",
  "version": "1.0.84",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "real:html": "node scripts/real-workbench-server.mjs",
    "build": "vite build",
    "build:web": "vite build",
    "build:mac": "npm run build:web",
    "build:win": "npm run build:web",
    "build:ios": "npm run build:web && cap sync ios && npm run ios:register-plugin",
    "build:android": "npm run build:web && cap sync android",
    "preview": "vite preview --host 127.0.0.1",
    "mac:dev": "node scripts/mac-dev.mjs",
    "mac:preview": "npm run build:mac && AIWB_ELECTRON_MODE=preview electron .",
    "mac:preview:detached": "npm run build:mac && node scripts/start-mac-preview-detached.mjs",
    "mac:pack": "AIWB_APP_BUILD=${AIWB_APP_BUILD:-$(TZ=Asia/Shanghai date +%Y%m%d%H%M)}; export AIWB_APP_BUILD; npm run build:mac && CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/electron-builder/cli.js --mac --config.buildVersion=$AIWB_APP_BUILD && npm run mac:install",
    "mac:mas": "npm run build:mac && node scripts/build-mas.mjs mas",
    "mac:mas:dev": "npm run build:mac && node scripts/build-mas.mjs mas-dev",
    "mac:mas:universal": "npm run build:mac && AIWB_MAC_ARCH=universal node scripts/build-mas.mjs mas",
    "mac:mas:upload": "node scripts/upload-mas-xcode.mjs",
    "mac:mas:upload:api": "node scripts/upload-mas.mjs",
    "mac:mas:upload:xcode": "node scripts/upload-mas-xcode.mjs",
    "mac:mas:publish": "npm run mac:mas && npm run mac:mas:upload:xcode",
    "mac:install": "node scripts/install-mac-app.mjs",
    "win:pack": "npm run build:win && electron-builder --win --x64 --config.directories.output=build/win",
    "win:pack:portable": "npm run build:win && electron-builder --win portable --x64 --config.directories.output=build/win",
    "release:check": "node scripts/release-all.mjs --check --target all",
    "release": "node scripts/release-all.mjs --target all --upload",
    "release:ios": "node scripts/release-all.mjs --target ios --upload",
    "release:macos": "node scripts/release-all.mjs --target macos --upload",
    "release:prepare": "node scripts/release-all.mjs --target all",
    "ios:register-plugin": "node scripts/register-ios-plugin.mjs",
    "ios:sync": "npm run build:ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "android:sync": "npm run build:android",
    "android:open": "npm run android:sync && cap open android",
    "android:build": "npm run android:sync && cd android && if [ -x /usr/libexec/java_home ] && /usr/libexec/java_home -v 21 >/dev/null 2>&1; then JAVA_HOME=$(/usr/libexec/java_home -v 21) ./gradlew assembleDebug; else ./gradlew assembleDebug; fi",
    "assistant:describe": "node scripts/aiwb-assistant-cli.mjs describe",
    "assistant:capabilities": "node scripts/aiwb-assistant-cli.mjs capabilities --format json",
    "assistant:schema": "node scripts/aiwb-assistant-cli.mjs schema",
    "assistant:prompt": "node scripts/aiwb-assistant-cli.mjs prompt --format json",
    "assistant:intent": "node scripts/aiwb-assistant-cli.mjs intent",
    "agent:export:github": "node scripts/export-agent-github.mjs",
    "agent:publish": "node scripts/release-agent.mjs",
    "agent:publish:oss": "node scripts/publish-agent-oss.mjs",
    "agent:prune": "node scripts/prune-agent-versions.mjs",
    "agent:prune:apply": "node scripts/prune-agent-versions.mjs --apply",
    "voice:configure-local": "node scripts/configure-local-voice.mjs",
    "test": "node --test scripts/test-*.mjs",
    "test:ci": "npm test && npm run build",
    "test:lifecycle": "node scripts/test-message-lifecycle.mjs",
    "test:ssh-reconnect": "node scripts/test-ssh-reconnect.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.27.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ssh2": "^1.17.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "description": "A multi-device prototype for a lightweight AI workbench that connects to an Alibaba Cloud ECS over SSH and controls remote CLI agents such as Codex CLI, Claude CLI, or custom commands.",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
