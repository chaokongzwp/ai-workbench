kill "$AIWB_HEARTBEAT_PID" >/dev/null 2>&1 || true
wait "$AIWB_HEARTBEAT_PID" 2>/dev/null || true
if [ -n "$AIWB_CLAUDE_WATCHDOG_PID" ]; then
