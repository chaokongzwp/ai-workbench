    return 0
  fi
  for candidate in     /opt/homebrew/bin/node     /usr/local/bin/node     /usr/bin/node     "$HOME/.local/bin/node"     "$HOME/.volta/bin/node"     "$HOME/.asdf/shims/node"     "$HOME"/.nvm/versions/node/*/bin/node     "$HOME"/.fnm/node-versions/*/installation/bin/node; do
    if [ -x "$candidate" ]; then
      printf "%s
" "$candidate"
      return 0
    fi
