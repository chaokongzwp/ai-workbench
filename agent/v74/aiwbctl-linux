  wait "$AIWB_CLAUDE_WATCHDOG_PID" 2>/dev/null || true
fi
aiwb_write_file "$AIWB_TASK_DIR/command_pid" ""
aiwb_build_execution_summary "$AIWB_EXIT_CODE"
